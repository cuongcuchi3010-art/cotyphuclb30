{
  "name": "co-ty-phu-clb30",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @cotyphu/client build && pnpm --parallel --filter @cotyphu/worker --filter @cotyphu/client dev",
    "build": "pnpm --filter @cotyphu/client build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "deploy": "pnpm --filter @cotyphu/client build && pnpm --filter @cotyphu/worker run deploy"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "prettier": "^3.10.1",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.73.0"
  }
}
